<mj-section padding="32px 32px 0">
    <mj-column>
        <mj-image align="center"
                  width="160px"
                  padding="0"
                  css-class="logo">
        </mj-image>

        <mj-text align="left"
                 css-class="email-title"
                 font-weight="bold"
                 font-size="22px"
                 line-height="28px"
                 padding="24px 0 0">
            <span th:text="${title}">
                Beispieltitle
            </span>
        </mj-text>

        <mj-divider padding="24px 0 0"/>
    </mj-column>
</mj-section>
