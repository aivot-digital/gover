<mjml lang="de">
    <mj-head>
        <mj-include path="../partials/head.mjml" />

        <mj-html-attributes>
            <mj-selector path=".primary-action a">
                <mj-html-attribute name="th:href">${base.config.createUrl('/staff/submissions/' + submission.id)}</mj-html-attribute>
            </mj-selector>
        </mj-html-attributes>

        <mj-preview>
            Hinweis auf eine fehlgeschlagene Übertragung an eine Schnittstelle
        </mj-preview>
    </mj-head>
    <mj-body>
        <mj-include path="../partials/header.mjml"/>

        <mj-section>
            <mj-column>
                <mj-text>
                    <p>
                        Hallo,
                    </p>

                    <p>
                        die Übertragung an die hinterlegte Schnittstelle ist fehlgeschlagen.
                    </p>
                </mj-text>

                <mj-table cellpadding="0"
                          cellspacing="0"
                          font-size="15px"
                          line-height="22px"
                          padding="8px 0 0"
                          width="100%">
                    <tr>
                        <th scope="row" style="border-bottom:1px solid #e5e7eb;color:#5f6368;font-weight:normal;padding:10px 16px 10px 0;text-align:left;vertical-align:top;width:38%;">
                            Antrag
                        </th>
                        <td style="border-bottom:1px solid #e5e7eb;color:#242424;font-weight:bold;padding:10px 0;vertical-align:top;word-break:break-word;">
                            <span th:text="${form.internalTitle}">Beispielformular</span>
                            · Version <span th:text="${form.version}">1.0.0</span>
                        </td>
                    </tr>
                    <tr>
                        <th scope="row" style="border-bottom:1px solid #e5e7eb;color:#5f6368;font-weight:normal;padding:10px 16px 10px 0;text-align:left;vertical-align:top;width:38%;">
                            Schnittstelle
                        </th>
                        <td style="border-bottom:1px solid #e5e7eb;color:#242424;font-weight:bold;padding:10px 0;vertical-align:top;word-break:break-word;"
                            th:text="${destination.name}">
                            Beispiel-Schnittstelle
                        </td>
                    </tr>
                    <tr>
                        <th scope="row" style="border-bottom:1px solid #e5e7eb;color:#5f6368;font-weight:normal;padding:10px 16px 10px 0;text-align:left;vertical-align:top;width:38%;">
                            Fehlermeldung
                        </th>
                        <td style="border-bottom:1px solid #e5e7eb;color:#242424;font-weight:bold;padding:10px 0;vertical-align:top;word-break:break-word;"
                            th:text="${submission.destinationResult}">
                            Beispiel-Fehlermeldung
                        </td>
                    </tr>
                    <tr>
                        <th scope="row" style="color:#5f6368;font-weight:normal;padding:10px 16px 10px 0;text-align:left;vertical-align:top;width:38%;">
                            Zeitpunkt
                        </th>
                        <td style="color:#242424;font-weight:bold;padding:10px 0;vertical-align:top;">
                            <span th:text="${#numberformat.formatInstant(submission.destinationTimestamp, 'dd.MM.yyyy HH:mm')}">29.02.2024 11:54</span> Uhr
                        </td>
                    </tr>
                </mj-table>

                <mj-button align="left"
                           css-class="primary-action"
                           href="#"
                           padding="24px 0 0">
                    Antrag öffnen
                </mj-button>
            </mj-column>
        </mj-section>

        <mj-include path="../partials/default-mail-signature.mjml"/>
        <mj-include path="../partials/auto-generate-hint.mjml"/>
    </mj-body>
</mjml>
