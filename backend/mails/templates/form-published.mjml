<mjml lang="de">
    <mj-head>
        <mj-include path="../partials/head.mjml" />

        <mj-html-attributes>
            <mj-selector path=".primary-action a">
                <mj-html-attribute name="th:href">${base.config.createUrl('/' + form.slug)}</mj-html-attribute>
            </mj-selector>
        </mj-html-attributes>

        <mj-preview>
            Information zur Veröffentlichung eines Formulars
        </mj-preview>
    </mj-head>
    <mj-body>
        <mj-include path="../partials/header.mjml" />

        <mj-section>
            <mj-column>
                <mj-text>
                    <p>
                        Hallo,
                        <br/>
                        es wurde ein Formular in Prosuna veröffentlicht.
                        <br/>
                        <br/>
                        Formular: <b th:text="${form.internalTitle}">Beispielformular</b>
                        <br/>
                        Version: <b th:text="${form.version}">1.2.3</b>
                        <br/>
                        <span>
                            Entwickelnde Organisationseinheit:
                            <b th:text="${developingDepartment.name}">—</b>
                        </span>
                        <br th:if="${responsibleDepartment != null}" />
                        <span th:if="${responsibleDepartment != null}">
                            Zuständige Organisationseinheit:
                            <b th:text="${responsibleDepartment.name}">—</b>
                        </span>
                        <br th:if="${managingDepartment != null}" />
                        <span th:if="${managingDepartment != null}">
                            Bewirtschaftende Organisationseinheit:
                            <b th:text="${managingDepartment.name}">—</b>
                        </span>
                        <br/>
                        Veröffentlicht durch: <b th:text="${triggeringUser.getFullName}">Max Mustermann</b>
                    </p>
                </mj-text>

                <mj-button align="left"
                           css-class="primary-action"
                           href="#"
                           padding="24px 0 0">
                    Formular öffnen
                </mj-button>
            </mj-column>
        </mj-section>

        <mj-include path="../partials/default-mail-signature.mjml"/>
        <mj-include path="../partials/auto-generate-hint.mjml"/>
    </mj-body>
</mjml>
