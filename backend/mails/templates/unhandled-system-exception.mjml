<mjml lang="de">
    <mj-head>
        <mj-include path="../partials/head.mjml"/>

        <mj-preview>
            Ein technischer Fehler ist aufgetreten – nähere Details enthalten
        </mj-preview>
    </mj-head>
    <mj-body>
        <mj-include path="../partials/header.mjml"/>

        <mj-section>
            <mj-column>
                <mj-text>
                    <p>
                        Hallo,
                        <br/>
                        es ist ein Fehler aufgetreten am Host <b th:text="${base.config.prosunaHostname}">https://prosuna.de</b>.
                    </p>

                    <h2>Fehlermeldung</h2>

                    <div style="background-color:#f5f6f7;border-left:4px solid #9aa0a6;padding:16px;word-break:break-word;">
                        <span th:text="${message}">Beispiel-Fehlermeldung</span>
                    </div>

                    <div th:if="${additionalContext != null && !additionalContext.isEmpty()}">
                        <h2>Weitere Informationen</h2>

                        <table cellpadding="0"
                               cellspacing="0"
                               style="border-collapse:collapse;font-size:14px;line-height:20px;width:100%;">
                            <tbody>
                                <tr th:each="entryKey : ${additionalContext.entrySet()}">
                                    <th scope="row"
                                        style="border-bottom:1px solid #e5e7eb;color:#5f6368;font-weight:normal;padding:8px 16px 8px 0;text-align:left;vertical-align:top;width:38%;"
                                        th:text="${entryKey.key}">Schlüssel</th>
                                    <td style="border-bottom:1px solid #e5e7eb;color:#242424;padding:8px 0;vertical-align:top;word-break:break-word;"
                                        th:text="${entryKey.value}">Wert</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <h2>Stacktrace</h2>

                    <pre style="background-color:#f5f6f7;font-family:Courier New, monospace;font-size:12px;line-height:18px;margin:0;overflow-wrap:anywhere;padding:16px;white-space:pre-wrap;word-break:break-word;"><code th:text="${stackTrace}">Stacktrace</code></pre>
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-include path="../partials/default-mail-signature.mjml"/>
        <mj-include path="../partials/auto-generate-hint.mjml"/>
    </mj-body>
</mjml>
