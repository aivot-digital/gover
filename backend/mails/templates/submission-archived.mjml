<mjml lang="de">
    <mj-head>
        <mj-include path="../partials/head.mjml"/>

        <mj-html-attributes>
            <mj-selector path=".primary-action a">
                <mj-html-attribute name="th:href">${base.config.createUrl('/staff/submissions/' + submission.id)}</mj-html-attribute>
            </mj-selector>
        </mj-html-attributes>

        <mj-preview>
            Benachrichtigung über die Archivierung eines Antrags
        </mj-preview>
    </mj-head>
    <mj-body>
        <mj-include path="../partials/header.mjml"/>

        <mj-section>
            <mj-column>
                <mj-text>
                    <p>
                        Hallo,
                        <br/>
                        ein Antrag wurde in Prosuna abgeschlossen.
                        <br/>
                        <br/>
                        Antrag auf: <b th:text="${form.internalTitle}">Beispielformular</b> - Version
                        <b th:text="${form.version}">1.0.0</b>
                        <br/>
                        Aktenzeichen:
                        <b th:text="${fileNumber}">Aktenzeichen</b>
                        <br/>
                        <th:block th:if="${assignee != null}">
                            Zuständige Mitarbeiter:in:
                            <b th:text="${assignee.getFullName}">Max Mustermann</b>
                            <br/>
                        </th:block>
                        Abgeschlossen durch:
                        <b th:text="${triggeringUser.getFullName}">Erika Musterfrau</b>
                    </p>
                </mj-text>

                <mj-table cellpadding="0"
                          cellspacing="0"
                          font-size="15px"
                          line-height="22px"
                          padding="8px 0 0"
                          width="100%">
                    <tr>
                        <td style="background-color:#f5f6f7;border-left:4px solid #9aa0a6;color:#242424;padding:16px;">
                            <b>Hinweis zur Löschfrist</b><br/>
                            Die hinterlegte Löschfrist beginnt ab sofort zu laufen. Die Daten werden
                            nach Ablauf der Löschfrist automatisch gelöscht.
                        </td>
                    </tr>
                </mj-table>

                <mj-button align="left"
                           css-class="primary-action"
                           href="#"
                           padding="24px 0 0">
                    Antrag öffnen
                </mj-button>
            </mj-column>
        </mj-section>

        <mj-include path="../partials/default-mail-signature.mjml"/>
        <mj-include path="../partials/auto-generate-hint.mjml"/>
    </mj-body>
</mjml>
