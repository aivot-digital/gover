<mjml lang="de">
    <mj-head>
        <mj-include path="../partials/head.mjml"/>

        <mj-preview>
            Neue Nachricht
        </mj-preview>
    </mj-head>
    <mj-body>
        <mj-include path="../partials/header.mjml"/>

        <mj-section>
            <mj-column>
                <mj-text>
                    <div th:utext="${messageHtml}">
                        Nachricht
                    </div>
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-include path="../partials/default-mail-signature.mjml"/>

        <mj-section padding="32px 32px 28px">
            <mj-column>
                <mj-divider padding="0 0 20px"/>

                <mj-text css-class="email-footer"
                         color="#5f6368"
                         font-size="13px"
                         line-height="19px"
                         padding="0">
                    <p>
                        Diese Nachricht wurde über Prosuna versendet.
                        Bitte nicht auf diese E-Mail antworten.
                    </p>
                </mj-text>
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
